\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage[usenames,dvipsnames]{color}
\RequirePackage{listings}
\RequirePackage{hyperref}
\RequirePackage{graphicx}
\RequirePackage{etoolbox}

%=====================================================
% DEFINICIÓN DE COLORES
\definecolor{UCInterfaceColor}{rgb}{0.5, 0.5, 0.5}
\definecolor{UCCommandColor}{rgb}{0.5, 0.5, 0.5}
\definecolor{UCExtensionPointColor}{rgb}{0, 0, 0.7}
\definecolor{UCRealizationColor}{rgb}{0, 0, 0.7}
\definecolor{UCBussinesRuleColor}{rgb}{0, 0.5, 0}
\definecolor{RFReferenceColor}{rgb}{0, 0, 0.7}
\definecolor{FRMColor}{rgb}{0.3, 0.3, 1}
\definecolor{ComentarioColor}{rgb}{0.7, 0.7, 0.7}

%=====================================================
% COMANDOS DE REFERENCIA
\providecommand{\UCref}[2]{%
	\hypersetup{linkcolor=UCExtensionPointColor}%
	\hyperlink{#1}{#1~{}#2}%
	\hypersetup{linkcolor=black}%
}

\providecommand{\BRref}[2]{%
	\hypersetup{linkcolor=UCBussinesRuleColor}%
	\hyperlink{#1}{#1~{}#2}%
	\hypersetup{linkcolor=black}%
}

\providecommand{\IUref}[2]{%
	\includegraphics[height=10pt]{theme/uc/iu}~%
	\hypersetup{linkcolor=UCInterfaceColor}%
	\hyperlink{#1}{#1~{}#2}%
	\hypersetup{linkcolor=black}%
}

\providecommand{\MSGref}[2]{%
	\hypersetup{linkcolor=UCBussinesRuleColor}%
	\hyperlink{#1}{#1~{}#2}%
	\hypersetup{linkcolor=black}%
}

%=====================================================
% ENTORNO PRINCIPAL
\newenvironment{TestCase}[2]{%
	\newpage%
	\subsection{#2}%
	\begin{longtable}{|p{.25\textwidth}|p{.75\textwidth}|}%
		\arrayrulecolor{white}%
		\rowcolor{black}%
		\UCitem{\color{white}Caso de Prueba}{\color{white}#1 #2}%
		\arrayrulecolor{black}%
	}{%
	\end{longtable}%
}

%=====================================================
% ELEMENTOS DE DESCRIPCIÓN
\providecommand{\UCitem}[2]{%
	\textbf{#1} & #2 \\ \hline%
}

\providecommand{\CPlist}[2]{%
	#1 & \begin{itemize}[noitemsep,topsep=0pt]#2\end{itemize} \\ \hline%
}

%=====================================================
% BOTONES Y ELEMENTOS UI
\providecommand{\IUbutton}[1]{\keystroke{#1}}

%=====================================================
% ENTORNOS COMPACTOS
\ifundef{\Citemize}{%
	\newenvironment{Citemize}{%
		\begin{itemize}[noitemsep,topsep=0pt]%
		}{%
		\end{itemize}%
	}
}{%
	\PackageInfo{cdtPruebas}{Entorno Citemize ya definido. Se mantiene la versión existente.}
}

